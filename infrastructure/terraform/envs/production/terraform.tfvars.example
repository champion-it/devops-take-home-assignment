region             = "ap-southeast-2"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b", "ap-southeast-2c"]

# ---- Worker node auth — pick ONE of these two -----------------------------

# Option A: SSH key pair (RECOMMENDED for production)
# key_pair_name = "devops-takehome-keypair"

# Option B: root password (quick demo / dev only)
# Requirements: 8-26 chars, must include uppercase, lowercase, digit,
# and at least one of these special chars: !@$%^-_=+[{}]:,./?
# root_password = "ChangeMe!2026"

# ---- Argo CD GitOps repo --------------------------------------------------
git_repo     = "https://github.com/champion-it/devops-demo-assignment.git"
git_revision = "main"
